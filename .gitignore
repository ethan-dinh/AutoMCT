# MicroCT-Analysis: local environments, generated data, and development artifacts.
# These rules do not untrack files already committed to Git.

# Operating-system metadata
.DS_Store
._*
.AppleDouble/
.LSOverride
.Spotlight-V100/
.Trashes/
__MACOSX/
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Python bytecode, native extensions, and tool caches
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.nbc
*.nbi
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.hypothesis/
.tox/
.nox/

# Virtual environments (env/ contains versioned Conda documentation)
.venv/
venv/
venv.bak/
.conda/
.python-version
.direnv/
/env/*
!/env/README.md
!/env/environment.yml

# Python packaging and build artifacts
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
wheelhouse/
.installed.cfg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Test coverage and generated reports
.coverage
.coverage.*
coverage.xml
htmlcov/
coverage/
nosetests.xml
junit.xml
*.cover
*.py,cover

# Jupyter and IPython runtime state (keep notebooks)
.ipynb_checkpoints/
.ipython/
profile_default/

# R session state and local package libraries (keep R/Rmd source)
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/
.Rcache/
renv/library/
renv/staging/

# JavaScript dependencies and build caches (keep lockfiles)
node_modules/
.npm/
.parcel-cache/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor state and temporary files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace
*.swp
*.swo
*~
*.bak
*.tmp
*.temp
~$*
.claude/settings.local.json

# Local secrets and configuration (keep documented examples)
.env
.env.*
!.env.example
!.env.sample
!.env.template
.envrc
.aws/
*.pem
*.key

# Logs and temporary work directories
*.log
*.log.*
logs/
tmp/
temp/

# Generated analysis data: use these directories for local scans and exports.
# Avoid global image/CSV/JSON rules so figures, fixtures, and configs stay visible.
/data/
/datasets/
/scans/
output/
outputs/
results/
segmentation_results/
_sr_work/

# Training runs, model weights, and experiment tracking
/ML-Segmentation/runs/*
/ML-Segmentation/runs_*/
checkpoints/
lightning_logs/
wandb/
mlruns/
mlartifacts/
events.out.tfevents.*
*.pt
*.pth
*.ckpt
*.onnx

# Large generated poster volume payloads (keep accompanying source/metadata)
/poster_assets/*

# Claude
.claude/*